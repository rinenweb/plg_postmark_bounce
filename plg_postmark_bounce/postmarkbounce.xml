<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>Postmark Bounce Notifier</name>
    <version>1.0.1</version>
    <description>Joomla plugin to receive Postmark bounce webhooks and notify the administrator via email.</description>
    <author>Rinenweb</author>
    <authorEmail>info@rinenweb.eu</authorEmail>
    <authorUrl>https://www.rinenweb.eu</authorUrl>
    <creationDate>2025-02-23</creationDate>
    <license>GNU General Public License version 3 or later</license>
    <files>
        <filename plugin="postmarkbounce">postmarkbounce.php</filename>
        <folder>language</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="webhook_info" type="note" label="PLG_SYSTEM_POSTMARKBOUNCE_WEBHOOK_INSTRUCTIONS" description="PLG_SYSTEM_POSTMARKBOUNCE_WEBHOOK_INSTRUCTIONS_DESC"/>
                <field name="spacer" type="spacer" hr="true"/>
                <field name="notification_email" type="email" label="PLG_SYSTEM_POSTMARKBOUNCE_NOTIFICATION_EMAIL" description="PLG_SYSTEM_POSTMARKBOUNCE_NOTIFICATION_EMAIL_DESC" validate="email"/>
                <field name="webhook_token" type="text" label="PLG_SYSTEM_POSTMARKBOUNCE_TOKEN" description="PLG_SYSTEM_POSTMARKBOUNCE_TOKEN_DESC" filter="string"/>
            </fieldset>
        </fields>
    </config>
</extension>
